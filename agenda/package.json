{
  "name": "prumo-agenda",
  "private": true,
  "version": "0.1.0",
  "description": "Prumo — Agenda. Plataforma-irmã do Toolbox, banco e deploy próprios, conversa com o Fluxo só por contrato de API.",
  "scripts": {
    "dev": "wrangler pages dev public --local --persist-to=.wrangler/state --port 8790",
    "db:migrate:local": "wrangler d1 execute prumo-agenda-db --local --persist-to=.wrangler/state --file=./migrations/0001_init.sql",
    "db:seed:local": "wrangler d1 execute prumo-agenda-db --local --persist-to=.wrangler/state --file=./migrations/0002_seed.sql",
    "db:migrate:remote": "wrangler d1 execute prumo-agenda-db --remote --file=./migrations/0001_init.sql",
    "db:seed:remote": "wrangler d1 execute prumo-agenda-db --remote --file=./migrations/0002_seed.sql",
    "seed:gen": "node scripts/gerar-seed.mjs",
    "deploy": "wrangler pages deploy public --project-name=prumo-agenda"
  },
  "devDependencies": {
    "wrangler": "^4.123.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true
  }
}
