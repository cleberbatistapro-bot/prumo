{
  "name": "prumo-fluxo",
  "private": true,
  "version": "0.1.0",
  "description": "Prumo — Fluxo. Plataforma-irmã do trabalho visível. Fase 0: autenticação, RBAC e auditoria.",
  "scripts": {
    "dev": "wrangler pages dev public --local --persist-to=.wrangler/state",
    "db:migrate:local": "wrangler d1 execute prumo-fluxo-db --local --persist-to=.wrangler/state --file=./migrations/0001_init.sql",
    "db:seed:local": "wrangler d1 execute prumo-fluxo-db --local --persist-to=.wrangler/state --file=./migrations/0002_seed.sql",
    "db:migrate:remote": "wrangler d1 execute prumo-fluxo-db --remote --file=./migrations/0001_init.sql",
    "db:seed:remote": "wrangler d1 execute prumo-fluxo-db --remote --file=./migrations/0002_seed.sql",
    "seed:gen": "node scripts/gerar-seed.mjs",
    "deploy": "wrangler pages deploy public --project-name=prumo-fluxo"
  },
  "devDependencies": {
    "wrangler": "^4.123.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true
  }
}
